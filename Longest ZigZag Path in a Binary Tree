class Solution {
public:
    int max_path =0;
    void solve(TreeNode* root,int steps,bool go_left){
        if(root==NULL) return ;
        max_path = max(max_path,steps);

        if(go_left==true){
            solve(root->left,steps+1,false);
            solve(root->right,1,true);
        }
        else{
            solve(root->right,steps+1,true);
            solve(root->left,1 ,false);
        }
    }
    int longestZigZag(TreeNode* root) {
      solve(root,0,false);
      solve(root,0,true);

      return max_path;

    }
};
class Solution {
public:
    int maxPath = 0;
    void solve(TreeNode* root,int l,int r){
         if(!root) return;

         maxPath = max({maxPath,l,r});

         solve(root->left,r+1,0);
         solve(root->right,0,l+1);
    }
    int longestZigZag(TreeNode* root) {

        solve(root,0,0);

    return maxPath;    
        
    }
};
